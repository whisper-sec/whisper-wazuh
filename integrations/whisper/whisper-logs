#!/bin/sh
# whisper-logs — Whisper agent-activity log source for Wazuh (keyed tier).
# Wrapper modeled on the stock Wazuh integration launchers (and the sibling custom-whisper
# wrapper): resolves the manager's bundled Python and execs whisper-logs.py with argv intact.
# Scheduled by the whisper-logs command wodle (see install.sh --logs); may also be run by hand.
# Install target: /var/ossec/integrations/whisper-logs (750 root:wazuh).
#
# Like custom-whisper, it always pairs the .py next to itself and FAILS LOUDLY when the
# interpreter or script is missing rather than handing Python an empty program path.
#
# Copyright (C) whisper.security — Apache-2.0

WPYTHON_BIN="framework/python/bin/python3"

SCRIPT_PATH_NAME="$0"

DIR_NAME="$(cd "$(dirname "${SCRIPT_PATH_NAME}")" && pwd -P)"
SCRIPT_NAME="$(basename "${SCRIPT_PATH_NAME}")"

case ${DIR_NAME} in
    */integrations)
        # Installed layout: {WAZUH_HOME}/integrations/whisper-logs
        WAZUH_PATH="${WAZUH_PATH:-$(cd "${DIR_NAME}/.." && pwd)}"
    ;;
    *)
        # Any other location (e.g. the repo checkout) — default to the standard home.
        WAZUH_PATH="${WAZUH_PATH:-/var/ossec}"
    ;;
esac

PYTHON_BIN="${WAZUH_PATH}/${WPYTHON_BIN}"
PYTHON_SCRIPT="${DIR_NAME}/${SCRIPT_NAME}.py"

if [ ! -x "${PYTHON_BIN}" ]; then
    echo "${SCRIPT_NAME}: wazuh python not found or not executable: ${PYTHON_BIN}" >&2
    exit 1
fi

if [ ! -f "${PYTHON_SCRIPT}" ]; then
    echo "${SCRIPT_NAME}: integration script not found: ${PYTHON_SCRIPT}" >&2
    exit 1
fi

exec "${PYTHON_BIN}" "${PYTHON_SCRIPT}" "$@"
